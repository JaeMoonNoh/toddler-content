// 스키마 변경 후: pnpm --filter @toddler/api exec prisma migrate dev --name <변경내용>

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// 사이트에 올리는 혜택 한 건. 목록은 data/benefit-catalog.json에서 관리하고 pnpm benefit sync로 반영한다
model Benefit {
  id                String          @id @default(cuid())
  slug              String          @unique
  name              String
  regionCode        String // 어느 지역 혜택인지. 법정동코드 10자리 (전국 0000000000)
  sourceUrl         String // 사용자에게 보여줄 원문 링크
  schedule          Json? // 신청 기간 규칙 (BenefitSchedule). 출산예정일로 날짜를 계산하는 건 브라우저가 한다
  conditions        String[]        @default([]) // 받기 위한 조건 (EligibilityCondition). 예: BIRTH_PARENT_INSURED
  amount            Json? // 받는 금액 (BenefitAmount). 출생 순위별 구간, 근거
  applicationPeriod Json? // 해마다 공고하는 사업의 올해 신청 기간 (ApplicationPeriod). 상시 신청이면 null
  howToApply        Json? // 어디서 어떻게 신청하는지 (HowToApply). 아직 정리하지 않았으면 null
  audience          String? // 특정 대상만 받는 혜택의 묶음 (Audience). 화면에서 접어 보여준다. 누구나 받으면 null
  verifiedAt        DateTime? // 사람이 마지막으로 확인한 시각. null이면 확인 전이라 게시하지 않는다
  sources           BenefitSource[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// 혜택이 근거로 삼는 공공 API 원본. 수집 전 ID일 수도 있어서 SourceItem에 외래키를 걸지 않는다
model BenefitSource {
  id              String     @id @default(cuid())
  benefitId       String
  benefit         Benefit    @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  position        Int // 0이 대표 출처
  source          DataSource
  externalId      String
  verifiedPayload Json? // 확인할 때 원본 그대로. 무엇이 바뀌었는지 보여줄 때 쓴다

  @@unique([benefitId, source, externalId])
  @@index([source, externalId])
}

// ── 공공 API 원본과 변경 감지 ─────────────────────────────

enum DataSource {
  GOV24 // 보조금24 (행정안전부 공공서비스 정보)
  BOKJIRO_NATIONAL // 복지로 중앙부처 복지서비스
  BOKJIRO_LOCAL // 복지로 지자체 복지서비스
}

enum ChangeType {
  ADDED
  UPDATED
  REMOVED
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// 출처에서 받은 항목의 최신 원본. 출처 + 출처의 ID로 한 건을 식별한다
model SourceItem {
  id          String         @id @default(cuid())
  source      DataSource
  externalId  String
  name        String
  payload     Json // API가 준 그대로 (비교에서 빼는 필드 포함)
  firstSeenAt DateTime       @default(now())
  lastSeenAt  DateTime       @default(now())
  removedAt   DateTime? // 출처 목록에서 사라진 시각. 다시 나타나면 null로 되돌린다
  changes     SourceChange[]

  @@unique([source, externalId])
}

// 수집 한 번에서 발견한 변경 한 건
model SourceChange {
  id            String        @id @default(cuid())
  type          ChangeType
  itemId        String
  item          SourceItem    @relation(fields: [itemId], references: [id])
  runId         String
  run           CollectionRun @relation(fields: [runId], references: [id])
  changedFields Json? // UPDATED일 때 [{ field, before, after }]
  detectedAt    DateTime      @default(now())

  @@index([runId])
  @@index([detectedAt])
}

// 출처별 수집 실행 기록
model CollectionRun {
  id         String         @id @default(cuid())
  source     DataSource
  status     RunStatus      @default(RUNNING)
  startedAt  DateTime       @default(now())
  finishedAt DateTime?
  itemCount  Int?
  added      Int            @default(0)
  updated    Int            @default(0)
  removed    Int            @default(0)
  error      String?
  changes    SourceChange[]

  @@index([source, startedAt])
}

// 출처 항목의 최신 상세 원본. 복지로는 목록에 요약만 있어서 지원대상·선정기준·지원내용을 상세 API로 따로 받는다
model SourceDetail {
  id         String               @id @default(cuid())
  source     DataSource
  externalId String
  name       String
  payload    Json // API가 준 그대로 (비교에서 빼는 필드 포함)
  fetchedAt  DateTime // 마지막으로 받은 시각
  changedAt  DateTime? // 마지막으로 바뀐 것을 발견한 시각. 처음 받은 뒤 바뀐 적이 없으면 null
  changes    SourceDetailChange[]

  @@unique([source, externalId])
}

// 상세를 다시 받았을 때 발견한 변경 한 건
model SourceDetailChange {
  id            String       @id @default(cuid())
  detailId      String
  detail        SourceDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)
  changedFields Json // [{ field, before, after }]
  detectedAt    DateTime

  @@index([detailId])
  @@index([detectedAt])
}

// ── 회원 ─────────────────────────────────────────────

enum SocialProvider {
  KAKAO
}

// 로그인한 사람. 이름·이메일·전화번호는 받지 않는다
model User {
  id            String          @id @default(cuid())
  accounts      SocialAccount[]
  sessions      Session[]
  conditions    UserConditions?
  savedBenefits SavedBenefit[]
  createdAt     DateTime        @default(now())
}

// 계정에 이은 로그인 수단. 한 계정에 카카오·네이버·구글을 여러 개 이을 수 있다
model SocialAccount {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       SocialProvider
  providerUserId String // 수단 안의 회원번호
  createdAt      DateTime       @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

// 로그인 세션. 쿠키의 토큰은 해시로만 저장한다
model Session {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// 로그인한 사람이 동의하고 저장한 조건. 서버는 이 값으로 찾거나 거르지 않아서 통째로 JSON에 둔다
model UserConditions {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conditions  Json // SavedConditions: 사는 곳, 고용보험, 어린이집, 아이별 출산예정일·출생일·태명·이름·몇째
  consentedAt DateTime // 처음 저장에 동의한 시각
  updatedAt   DateTime
}

enum SavedBenefitState {
  TODO // 챙길 것
  APPLIED // 신청을 마침
}

// 로그인한 사람이 챙기려고 저장한 혜택. 혜택이 목록에서 빠져도 지우지 않고 화면에서만 숨는다
model SavedBenefit {
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug      String // Benefit.slug
  state     SavedBenefitState
  createdAt DateTime
  updatedAt DateTime

  @@id([userId, slug])
}
