// 스키마 변경 후: pnpm --filter @toddler/api exec prisma migrate dev --name <변경내용>

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// 혜택 한 건. 모든 혜택은 출처와 최종 확인일을 가진다 (확인 전이면 verifiedAt = null)
model Benefit {
  id         String    @id @default(cuid())
  slug       String    @unique
  name       String
  scope      String    // national, chungbuk, cheongju 같은 적용 지역
  sourceName String
  sourceUrl  String
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
