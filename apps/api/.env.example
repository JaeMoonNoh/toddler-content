# apps/api/.env로 복사해서 쓴다. 서버와 CLI는 시작할 때 이 값을 검증하고, 필수 값이 없으면 시작하지 않는다 (src/config/env.validation.ts)

# 필수
DATABASE_URL="postgresql://toddler:toddler@localhost:5432/toddler?schema=public"
# 공공데이터포털 일반 인증키(Decoding). 비워 두면 서버와 CLI가 시작하지 않는다
DATA_GO_KR_SERVICE_KEY=

# 선택 (기본값)
# PORT=4000
# WEB_ORIGIN=http://localhost:3000
# COLLECT_SCHEDULE=on
# 카카오 로그인 (비워 두면 로그인 버튼이 나오지 않는다). 카카오 개발자 콘솔 > 앱 키 > REST API 키
# 콘솔의 Redirect URI에는 {WEB_ORIGIN}/api/auth/kakao/callback 을 등록한다 (로컬: http://localhost:3000/api/auth/kakao/callback)
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=   # off면 새벽 4시 자동 수집을 끈다
